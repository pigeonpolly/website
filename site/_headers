# Кэш в браузере (Cloudflare сам этот файл не публикует). Без него браузер на каждом переходе
# переспрашивал сервер про все стили, скрипты и картинки. Свои скрипты и стили в HTML идут с ?v=хеш,
# поэтому после обновления сайта страницы сразу берут новые; файлы, которые скрипты грузят сами
# (без ?v), могут быть старыми не дольше 5 минут.
/assets/*
  Cache-Control: public, max-age=300

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/files/*
  Cache-Control: public, max-age=86400
